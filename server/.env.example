# Scolrly API server configuration. Copy to `.env` and fill in.

# Port the API listens on (default 4000).
PORT=4000

# Secret used to sign student JWT session tokens. CHANGE THIS IN PRODUCTION.
JWT_SECRET=change-me-in-prod

# Shared secret the admin dashboard sends as x-admin-key. Must match the
# dashboard's SCOLRLY_ADMIN_KEY. CHANGE THIS IN PRODUCTION.
ADMIN_KEY=scolrly-admin-dev

# Optional. When set, Doubt Drop is answered by Claude (claude-opus-4-8);
# without it, the server falls back to the built-in retrieval matcher.
# ANTHROPIC_API_KEY=sk-ant-...

# Optional. Directory for the SQLite database file (default ./data).
# SCOLRLY_DATA_DIR=/data
